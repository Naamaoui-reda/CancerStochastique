# Streamlit Secrets Configuration Template
# -------------------------------------------------------------
# Local development:
#   Copy this file to `.streamlit/secrets.toml` and fill in any secrets.
#   Note: `.streamlit/secrets.toml` is ignored by Git to prevent leaking credentials.
#
# Streamlit Community Cloud:
#   In your app dashboard, go to Settings -> Secrets and paste your secrets in TOML format.
#
# Accessing secrets in Python:
#   import streamlit as st
#   my_secret = st.secrets.get("MY_SECRET_KEY", "default_value")
# -------------------------------------------------------------

[app]
environment = "production"
# example_api_key = "your-api-key-here"
